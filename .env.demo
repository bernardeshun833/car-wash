# Demo mode — committed on purpose, because there is nothing secret in it.
#
# `npm run dev:demo` and `npm run build:demo` load this file (Vite picks up
# .env.<mode>). It turns off every backend call: no Supabase project, no
# account, no keys. The attendant list, price list and everything logged live
# in the phone's own storage.
#
# What this is for: judging the screens on a real device before committing to
# any infrastructure. It cannot show you the nightly reconciliation or the
# report — those run server-side. `npm test` covers that half.
VITE_DEMO_MODE=true
