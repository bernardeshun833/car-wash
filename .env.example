# ---------------------------------------------------------------------------
# THIS IS THE CAR WASH DEPLOYMENT. Every value below belongs to the car wash's
# own Supabase project and its own accounts. It is a separate business from the
# barbershop: do not reuse that project's URL, keys, MoMo credentials or
# merchant account here. Nothing is shared.
# ---------------------------------------------------------------------------

# Tablet app (Vite — these are bundled into the client, so anon key only)
VITE_SUPABASE_URL=https://your-carwash-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Credentials the tablet uses to sign in as the site device. Provisioned once
# per tablet. Anyone with the built app has these — the anon key plus RLS is
# what limits what they can do, which is: insert transactions and cash counts,
# read the attendant and price lists. Nothing else.
VITE_DEVICE_EMAIL=device@yourwash.example
VITE_DEVICE_PASSWORD=

# Optional: which branch this tablet writes for. Defaults to the single branch
# seeded by migration 0001.
# VITE_BRANCH_ID=00000000-0000-0000-0000-00000000b1a1

# ---------------------------------------------------------------------------
# Counting agent (counting/src/run.ts). Runs on a box at the yard. It holds no
# Supabase key at all — only this URL and secret.
# ---------------------------------------------------------------------------
COUNTING_SOURCE=simulated
COUNTING_DEVICE_ID=counter-main-gate
COUNTING_BRANCH_ID=00000000-0000-0000-0000-00000000b1a1
COUNTING_INGEST_URL=https://your-carwash-project.supabase.co/functions/v1/vehicle-count-ingest
COUNTING_INGEST_SECRET=
# Sampling interval in ms. The agent refuses to start if this is too slow to
# catch a five-minute turnover — see counting/src/sampling.ts.
COUNTING_INTERVAL_MS=2000
COUNTING_SEED=1

# ---------------------------------------------------------------------------
# Edge function secrets. Set with `supabase secrets set KEY=value` — never
# committed and never bundled into the client.
# ---------------------------------------------------------------------------

# Must match COUNTING_INGEST_SECRET above.
COUNTING_INGEST_SECRET=

# MTN MoMo — the CAR WASH's own merchant account, not the barbershop's.
# Leave these empty while the wash is cash only: momo-sync skips cleanly when
# they are unset, and `momo_enabled` in branch_settings stays false so the
# nightly report does not check for money nobody is taking yet.
MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MOMO_SUBSCRIPTION_KEY=
MOMO_API_USER=
MOMO_API_KEY=
MOMO_TARGET_ENVIRONMENT=sandbox
# Optional: override if your approved MoMo product exposes statements elsewhere
# MOMO_STATEMENT_PATH=/collection/v1_0/account/statement

# Daily email report (Resend)
RESEND_API_KEY=
REPORT_FROM_EMAIL=reports@yourwash.example

# WhatsApp alerts on MEDIUM+ severity (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=+14155238886
